#!/usr/bin/env python3
"""A stub `glab` for the frontier tests. Only `glab api` exists, REST and GraphQL.

STUB_GLAB_FIXTURE  a JSON object mapping a request key to its response. The key is the
                   PATH without its query string, plus `?labels=X` when present.
                   `page=N` for N > 1 answers `[]`. A GraphQL call is keyed
                   `graphql:<iid>`, the iid taken from the query text. A missing key
                   answers `{"message": "404 Not Found"}` on stdout with
                   `glab: 404 Not Found (HTTP 404)` on stderr and exit 1.
STUB_GLAB_LOG      a file to append `start LABEL token=V` / `end LABEL token=V`. V is
                   GITLAB_TOKEN or `-`; LABEL is the path or `graphql:<iid>`.
STUB_GLAB_FAIL     a substring of LABEL; matching calls answer a server error and exit
                   1 with `(HTTP 500)`.

While a call is open the stub holds `<log>.lock`; if it cannot create it, the log gets
an `OVERLAP` line, which is how a test detects calls made in parallel.
"""
import json
import os
import re
import sys
import time

IID = re.compile(r'iids:\s*\[\s*"(\d+)"')


def log(line):
    path = os.environ.get("STUB_GLAB_LOG")
    if path:
        with open(path, "a", encoding="utf-8") as f:
            f.write(line + "\n")


def params(path):
    _, _, query = path.partition("?")
    return dict(p.split("=", 1) for p in query.split("&") if "=" in p)


def key_of(path):
    base, _, _ = path.partition("?")
    q = params(path)
    return base + (f"?labels={q['labels']}" if "labels" in q else "")


def token():
    return os.environ.get("GITLAB_TOKEN") or "-"


def response(key):
    fixture = os.environ.get("STUB_GLAB_FIXTURE")
    data = json.loads(open(fixture, encoding="utf-8").read()) if fixture else {}
    return data.get(key)


def body_for(label, path):
    """(exit code, stdout) for one call."""
    if path is not None and params(path).get("page") not in (None, "1"):
        return 0, json.dumps([])
    data = response(label)
    if data is None:
        print("glab: 404 Not Found (HTTP 404)", file=sys.stderr)
        return 1, json.dumps({"message": "404 Not Found"})
    return 0, json.dumps(data)


def call(label, body):
    lock = None
    if os.environ.get("STUB_GLAB_LOG"):
        lock = os.environ["STUB_GLAB_LOG"] + ".lock"
        try:
            os.close(os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY))
        except FileExistsError:
            lock = None
            log(f"OVERLAP {label} token={token()}")

    log(f"start {label} token={token()}")
    try:
        fail = os.environ.get("STUB_GLAB_FAIL")
        if fail and fail in label:
            print("glab: server error (HTTP 500)", file=sys.stderr)
            return 1
        time.sleep(0.05)
        code, out = body()
        if out:
            print(out)
        return code
    finally:
        log(f"end {label} token={token()}")
        if lock:
            os.remove(lock)


def main(argv):
    if argv[:1] != ["api"]:
        print("stub glab: only `glab api` is supported", file=sys.stderr)
        return 1
    rest = argv[1:]
    while rest[:1] == ["--hostname"] and len(rest) > 1:
        rest = rest[2:]
    if not rest:
        print("stub glab: api needs a path", file=sys.stderr)
        return 1
    path, rest = rest[0], rest[1:]

    if path == "graphql":
        query = ""
        while rest:
            if rest[0] == "-f" and len(rest) > 1:
                query, rest = rest[1], rest[2:]
            else:
                print(f"stub glab: unsupported argument {rest[0]}", file=sys.stderr)
                return 1
        m = IID.search(query)
        if not m:
            print("stub glab: the query names no iid", file=sys.stderr)
            return 1
        return call(f"graphql:{m.group(1)}", lambda: body_for(f"graphql:{m.group(1)}", None))

    return call(path, lambda: body_for(key_of(path), path))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
